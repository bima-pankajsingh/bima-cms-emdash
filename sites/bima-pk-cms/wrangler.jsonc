{
	// BIMA Pakistan content (offers, legal documents, About Us) on EmDash.
	// Production = top level (cdn-pk.milvik.app); staging = env.staging (cdn-pk-stg.milvik.app).
	// Deploy: `npm run deploy:staging` / `npm run deploy`. Never deploy production without sign-off.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bima-pk-cms",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// Production: cdn-pk.milvik.app, created 13 Oct 2026. Cloudflare Access covers /_emdash/* (app
	// "bima-pk-cms admin") and was in place before the first deploy - a fresh EmDash install lets the
	// first visitor of /_emdash/admin become its owner.
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "cdn-pk.milvik.app", "custom_domain": true }],
	// D1 in APAC with read replication on (an account setting, not in this file).
	"d1_databases": [
		{ "binding": "DB", "database_name": "bima-cms", "database_id": "96efa203-9b4d-469e-baac-6c61a03e8c3f" }
	],
	"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "bima-cms-media" }],
	"kv_namespaces": [
		{ "binding": "CACHE", "id": "49ff6a4be7e84b30b1bfdf8b6e6d7f6b" },
		{ "binding": "SESSION", "id": "c71ca855b52f4c128395c38e9c95cff8" }
	],
	// Sandboxed plugins need Worker Loader - Workers Paid plan. Off until the plan is upgraded, as on
	// staging (deploy refused with code 10195 on the free plan).
	// "worker_loaders": [{ "binding": "LOADER" }],
	// Search engines may index the documents only once this is "true" - set it at release, when
	// the wording is final. Until then every host is noindex, production included.
	"vars": { "SITE_INDEXABLE": "false" },
	// General maintenance cron: scheduled publishing and housekeeping. Required.
	"triggers": { "crons": ["* * * * *"] },
	// No Smart Placement: it forwards every request - cache hits included - to the region it
	// places the Worker in, near D1, so a page served from cache still crossed continents
	// (measured 13 Oct 2026). The page cache in src/worker.ts plus D1 read replicas do better.
	"env": {
		"staging": {
			"name": "bima-pk-cms-stg",
			// Never public before setup is done behind Cloudflare Access: a fresh EmDash install lets the
			// first visitor of /_emdash/admin become its owner. Served on cdn-pk-stg.milvik.app once Access
			// covers /_emdash/*.
			"workers_dev": false,
			"preview_urls": false,
			"routes": [{ "pattern": "cdn-pk-stg.milvik.app", "custom_domain": true }],
			"d1_databases": [
				{ "binding": "DB", "database_name": "bima-cms-stg", "database_id": "fac66ce5-946c-48c8-b7b0-6b06978f5dc3" }
			],
			"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "bima-cms-stg-media" }],
			// Staging is never indexed.
			"vars": { "SITE_INDEXABLE": "false" },
			"kv_namespaces": [
				{ "binding": "CACHE", "id": "ff5b6d8a31034f4a8dcb320394f84735" },
				// Astro sessions; created by wrangler's auto-provisioning on the first deploy.
				{ "binding": "SESSION", "id": "37c3f8dc50be4ac6baf9c6ddcec5724b" }
			],
			// Sandboxed plugins (legal-document archive) need Worker Loader - Workers Paid plan.
			// The account is on the free plan (deploy refused with code 10195, 13 Oct 2026); re-enable
			// once the plan is upgraded.
			// "worker_loaders": [{ "binding": "LOADER" }],
			"triggers": { "crons": ["* * * * *"] }
		}
	}
}
