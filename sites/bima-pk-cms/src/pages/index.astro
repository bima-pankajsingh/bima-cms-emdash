---
import Legal from "../layouts/Legal.astro";
import { DOCUMENTS } from "../lib/legal";
---

<Legal title="Documents" lang="en">
	<div class="bima-card">
		<div class="bima-card__header"><h1 class="bima-card__title">BIMA Pakistan</h1></div>
		<div class="bima-card__body">
			<ul>
				{Object.entries(DOCUMENTS).map(([slug, d]) => (
					<li><a href={`/pk/${slug}`}>{d.label.en}</a> · <a href={`/ur/pk/${slug}`} lang="ur">{d.label.ur}</a></li>
				))}
			</ul>
		</div>
	</div>
</Legal>
