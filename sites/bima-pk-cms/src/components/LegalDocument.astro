---
import { PortableText } from "emdash/ui";
import Legal from "../layouts/Legal.astro";
import { DOCUMENTS, isDraft, type LegalPage, type Locale } from "../lib/legal";

interface Props {
	locale: Locale;
	doc: string;
	page: LegalPage;
}

const { locale, doc, page } = Astro.props;
const data = page.entry.data;
const market = Astro.params.market;
const alternate = locale === "ur"
	? { href: `/${market}/${doc}`, lang: "en" as const }
	: { href: `/ur/${market}/${doc}`, lang: "ur" as const };
const showVersion = DOCUMENTS[doc].type !== "ABOUT_US";
const effective = data.effective_from
	? new Intl.DateTimeFormat(locale === "ur" ? "ur-PK" : "en-GB", { dateStyle: "long", timeZone: "UTC" })
		.format(new Date(data.effective_from))
	: null;
const t = locale === "ur"
	? {
		draftTitle: "مسودہ — حتمی نہیں",
		draft: "یہ متن ابھی منظور شدہ نہیں ہے اور تبدیل ہو سکتا ہے۔",
		fallback: "اس دستاویز کا اردو ترجمہ ابھی دستیاب نہیں ہے۔ انگریزی متن نیچے دیا گیا ہے۔",
		version: "ورژن",
		effective: "نافذ از",
	}
	: {
		draftTitle: "Draft — not final",
		draft: "This wording has not been approved and may change.",
		fallback: "",
		version: "Version",
		effective: "Effective",
	};
---

<Legal title={data.title} lang={locale} alternate={alternate}>
	<div class="legal-stack">
		{isDraft(data.notice_version) && (
			<div class="bima-alert bima-alert--warning" role="note">
				<div class="bima-alert__content">
					<div class="bima-alert__title">{t.draftTitle}</div>
					{t.draft}
				</div>
			</div>
		)}
		{page.fellBack && (
			<div class="bima-alert bima-alert--info" role="note">
				<div class="bima-alert__content">{t.fallback}</div>
			</div>
		)}
		<article class="bima-card" lang={page.locale} dir={page.locale === "ur" ? "rtl" : "ltr"}>
			<header class="bima-card__header">
				<h1 class="legal-title">{data.title}</h1>
				{showVersion && (
					<p class="bima-card__subtitle legal-meta">
						{t.version} <bdi dir="ltr">{data.notice_version}</bdi>{effective && <> · {t.effective} {effective}</>}
					</p>
				)}
			</header>
			<div class="bima-card__body legal-body">
				<PortableText value={data.body} />
			</div>
		</article>
	</div>
</Legal>

<style>
	.legal-stack { display: flex; flex-direction: column; gap: 16px; }
	.legal-title { margin: 0 0 var(--bima-space-2); font-size: clamp(1.75rem, 6vw, var(--bima-text-h2, 2rem)); }
	.legal-meta { margin: 0; font-variant-numeric: tabular-nums; }
	.legal-body :global(h2) { margin-top: var(--bima-space-8); }
	.legal-body :global(h3) { margin-top: var(--bima-space-6); }
	.legal-body :global(p), .legal-body :global(li) { overflow-wrap: anywhere; }
	.legal-body :global(li + li) { margin-top: var(--bima-space-2); }
	.legal-body :global(blockquote) {
		background: var(--bima-surface-muted);
		border-radius: var(--bima-radius-md);
		padding-block: var(--bima-space-3);
		padding-inline-end: var(--bima-space-4);
	}
	.legal-body :global(blockquote p) { margin: 0; }
	.legal-body > :global(:first-child) { margin-top: 0; }
</style>
