---
import { isProductionHost } from "../lib/legal";

interface Props {
	title: string;
	lang: "en" | "ur";
	description?: string;
}

const { title, lang, description } = Astro.props;
const dir = lang === "ur" ? "rtl" : "ltr";
const noindex = !isProductionHost(Astro.url);
---

<!doctype html>
<html lang={lang} dir={dir}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title} — BIMA Pakistan</title>
		{description && <meta name="description" content={description} />}
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Noto+Nastaliq+Urdu:wght@400;600&family=Source+Sans+3:wght@400;600;700&family=Source+Serif+4:opsz,wght@8..60,600&display=swap"
		/>
		<style is:global>
			:root {
				--ground: #f7f8fa;
				--paper: #ffffff;
				--ink: #17202b;
				--muted: #5b6676;
				--rule: #e1e5eb;
				--accent: #0b6e66;
				--draft-ground: #fff4d6;
				--draft-ink: #6b4a00;
				--draft-rule: #e9c46a;
				--quote: #eef4f3;
			}
			@media (prefers-color-scheme: dark) {
				:root {
					--ground: #0f141a;
					--paper: #161d25;
					--ink: #e6eaef;
					--muted: #9aa5b3;
					--rule: #2a3440;
					--accent: #5cc2b8;
					--draft-ground: #3a2e10;
					--draft-ink: #f3d68b;
					--draft-rule: #8a6d22;
					--quote: #1b2a2c;
				}
			}
			* { box-sizing: border-box; }
			html { -webkit-text-size-adjust: 100%; }
			body {
				margin: 0;
				background: var(--ground);
				color: var(--ink);
				font: 400 1.0625rem/1.65 "Source Sans 3", system-ui, -apple-system, "Segoe UI", sans-serif;
				padding-inline: 16px;
			}
			html[lang="ur"] body {
				font-family: "Noto Nastaliq Urdu", "Source Sans 3", serif;
				line-height: 2.2;
			}
			main {
				max-width: 42rem;
				margin: 0 auto;
				padding-block: 24px 48px;
			}
			a { color: var(--accent); }
			a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
		</style>
	</head>
	<body>
		<main>
			<slot />
		</main>
	</body>
</html>
