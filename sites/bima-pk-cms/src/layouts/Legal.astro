---
import { isProductionHost } from "../lib/legal";

interface Props {
	title: string;
	lang: "en" | "ur";
	description?: string;
	/** The same page in the other language, for the switch in the header. */
	alternate?: { href: string; lang: "en" | "ur" };
}

const { title, lang, description, alternate } = Astro.props;
const dir = lang === "ur" ? "rtl" : "ltr";
const noindex = !isProductionHost(Astro.url);
// The BIMA design system (ui.milvik.io), vendored at a pinned version - see public/vendor/bima-ui.
const UI = "/vendor/bima-ui/2.1.0";
---

<!doctype html>
<html lang={lang} dir={dir}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title} — BIMA Pakistan</title>
		{description && <meta name="description" content={description} />}
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="icon" type="image/png" sizes="32x32" href={`${UI}/favicon-32x32.png`} />
		<link rel="icon" type="image/png" sizes="16x16" href={`${UI}/favicon-16x16.png`} />
		<link rel="apple-touch-icon" href={`${UI}/apple-touch-icon.png`} />
		<link rel="stylesheet" href={`${UI}/bima.css`} />
		{lang === "ur" && (
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Nastaliq+Urdu:wght@400;600&display=swap" />
		)}
		<style is:global>
			/* BIMA UI is a light, left-to-right system; only what it lacks is added here. */
			/* .bima-container already carries the side gutter; it only needs border-box so its
			   width: 100% plus padding stays inside the screen. */
			.legal-shell { box-sizing: border-box; padding-block: 16px 48px; display: flex; flex-direction: column; gap: 16px; }
			.legal-shell *, .legal-shell *::before, .legal-shell *::after { box-sizing: border-box; }
			.legal-nav { padding: 12px 20px; }
			.legal-nav img { display: block; }
			.legal-nav__lang { color: var(--bima-text-inverse); font-weight: var(--bima-font-semibold); text-decoration: none; }
			.legal-nav__lang:hover, .legal-nav__lang:focus-visible { text-decoration: underline; }
			html[lang="ur"] body, html[lang="ur"] h1, html[lang="ur"] h2, html[lang="ur"] h3 {
				font-family: "Noto Nastaliq Urdu", var(--bima-font-body);
			}
			html[lang="ur"] body { line-height: 2.2; }
			[dir="rtl"] ul, [dir="rtl"] ol { padding-left: 0; padding-right: var(--bima-space-6); }
			[dir="rtl"] blockquote { padding-left: 0; border-left: 0; padding-right: var(--bima-space-4); border-right: 3px solid var(--bima-border-strong); }
		</style>
	</head>
	<body>
		<div class="bima-container bima-container--md legal-shell">
			<nav class="bima-navbar legal-nav" aria-label="BIMA Pakistan">
				<a class="bima-navbar__brand" href={lang === "ur" ? "/ur/pk/about" : "/pk/about"}>
					<img src={`${UI}/logo-white.png`} height="28" alt="BIMA" />
				</a>
				{alternate && (
					<a class="legal-nav__lang" href={alternate.href} lang={alternate.lang} hreflang={alternate.lang}>
						{alternate.lang === "ur" ? "اردو" : "English"}
					</a>
				)}
			</nav>
			<main>
				<slot />
			</main>
		</div>
	</body>
</html>
